VITE_COGNITO_USER_POOL_ID=eu-north-1_example
VITE_COGNITO_CLIENT_ID=your_public_app_client_id
VITE_COGNITO_DOMAIN=your-prefix.auth.eu-north-1.amazoncognito.com
# The URL must exactly match a Cognito app client callback and sign-out URL.
VITE_APP_URL=http://localhost:5173/
# For Docker Compose synthetic local mode only:
# VITE_DEV_MOCK_AUTH=true
# VITE_DEV_USER_SUB=dev_admin
# API: DEV_MOCK_AUTH=true (rejected with NODE_ENV=production)
