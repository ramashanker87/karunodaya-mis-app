{
  "name": "karunodaya-mis-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch api/src/server.ts",
    "build": "tsc -p tsconfig.api.json && vite build",
    "build:web": "vite build",
    "start:api": "node api/dist/api/src/server.js",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "migrate:dry-run": "tsx scripts/migrate-workbooks.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/s3-presigned-post": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "aws-amplify": "^6.15.5",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.0"
  }
}
